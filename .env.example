# Copy to .env and fill in what you have. Any source with missing keys is skipped (logged, never fatal).

# 1. Reddit — https://www.reddit.com/prefs/apps  (create a "script" app; read-only use)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=builder-sentiment-research/1.0 (by your_org)

# 2. Google Places API (New) — Google Cloud Console > enable "Places API (New)" > create API key
GOOGLE_PLACES_API_KEY=

# 3. X API v2 — https://developer.x.com > project > app > Bearer Token
X_BEARER_TOKEN=

# 4 & 5. Apify (Instagram + TikTok fallback) — https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# 5. TikTok Research API (optional, requires approved access) — https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Sentiment: OpenAI GPT-4o (omit to use the free local HuggingFace model)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
